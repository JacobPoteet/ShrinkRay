<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="urn:shrinkray-theme"
                    xmlns:vm="clr-namespace:ShrinkRay.App.ViewModels"
                    xmlns:views="clr-namespace:ShrinkRay.App.Views">

    <!-- What the main window and its setup cards both draw with -->

    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:InverseVisibilityConverter x:Key="Hidden" />
    <views:EmptyToCollapsedConverter x:Key="NotEmpty" />
    <views:FilledToCollapsedConverter x:Key="Empty" />

    <!-- Typed on monitor A: the phosphor text and a block caret over the glass, with a rule under it -->
    <Style x:Key="CrtSearch" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Phosphor}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SR.Phosphor}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SR.PhosphorDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Rule" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2"
                            BorderBrush="{DynamicResource SR.PhosphorDim}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rule" Property="BorderBrush" Value="{DynamicResource SR.Phosphor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A lamp with a silkscreen word, as printed on the panel -->
    <DataTemplate x:Key="SilkWord">
        <sr:TrackedText Text="{Binding}" Style="{StaticResource SR.Silk}" FontSize="11" Tracking="0.12"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=sr:Lamp}}" />
    </DataTemplate>

    <Style x:Key="PanelLamp" TargetType="sr:Lamp">
        <Setter Property="Diameter" Value="9" />
        <Setter Property="Spacing" Value="7" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
        <Setter Property="ContentTemplate" Value="{StaticResource SilkWord}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
    </Style>

    <DataTemplate x:Key="LampItem" DataType="{x:Type vm:LampViewModel}">
        <sr:Lamp Style="{StaticResource PanelLamp}" Content="{Binding Label}" State="{Binding State}" Blink="{Binding Blink}" />
    </DataTemplate>

    <!-- A row's menu: a plain moulded card with silkscreen items -->
    <Style x:Key="DeckMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="5" Padding="4" Background="{DynamicResource SR.BezelFill}"
                            BorderBrush="{DynamicResource SR.AbsLo}" BorderThickness="1">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeckMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Face" CornerRadius="3" Padding="12,6" Background="Transparent">
                        <sr:TrackedText Text="{TemplateBinding Header}" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold"
                                        FontSize="12" Tracking="0.16" Foreground="{DynamicResource SR.Ink}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource SR.KeyCap}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small text keycap for Choose, Setup and friends -->
    <Style x:Key="TextKey" TargetType="Button" BasedOn="{StaticResource SR.HardwareKey}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <sr:TrackedText Text="{Binding}" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="12"
                                    Tracking="0.14" Foreground="{DynamicResource SR.Ink}" Margin="10,0" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
