<Window x:Class="ShrinkRay.App.Views.MiniDeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sr="urn:shrinkray-theme"
        xmlns:vm="clr-namespace:ShrinkRay.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ShrinkRay mini cassette"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SR.ChassisSurface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DeckStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PlateLabel" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.SilkOnPlate}">
                <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- The small lit unit after a readout's digits, on their baseline -->
            <Style x:Key="Unit" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.Silk}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Tracking" Value="0" />
                <Setter Property="Margin" Value="4,0,0,1" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Foreground" Value="{DynamicResource SR.Phosphor}" />
                <Setter Property="Effect" Value="{DynamicResource SR.PhosphorTextGlow}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ShowDeckCommand}" />
    </Window.InputBindings>

    <!-- The whole case is a handle: drag it anywhere, double-click it for the deck -->
    <ContentControl x:Name="Case" Style="{StaticResource SR.Chassis}" Padding="18,18,24,16"
                    MouseLeftButtonDown="OnCaseDown" AutomationProperties.Name="{Binding DeckAutomationName}">
        <StackPanel Width="300">
            <DockPanel Margin="2,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SR.HardwareKey}" Width="34" Height="28" VerticalAlignment="Center"
                        Command="{Binding ShowDeckCommand}" AutomationProperties.Name="Open the deck" ToolTip="Open the deck">
                    <Path Data="{StaticResource OpenDeckIcon}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                </Button>
                <sr:Lamp Style="{StaticResource PanelLamp}" VerticalAlignment="Center"
                         Content="{Binding RunLamp.Label}" State="{Binding MiniLampState}" Blink="{Binding RunLamp.Blink}"
                         ToolTip="{Binding AttentionDetail}" ToolTipService.IsEnabled="{Binding AttentionDetail, Converter={StaticResource NotEmpty}}" />
            </DockPanel>

            <ContentControl Style="{StaticResource SR.Plate}" Padding="8">
                <Grid Height="114">
                    <sr:TapeDeck Density="Compact" Visibility="{Binding IsTapeLoaded, Converter={StaticResource Visible}}"
                                 SourcePack="{Binding SourcePack}" OutputPack="{Binding OutputPack}" IsSpinning="{Binding IsSpinning}"
                                 SourceSecondsPerTurn="{Binding SourceSecondsPerTurn}" OutputSecondsPerTurn="{Binding OutputSecondsPerTurn}"
                                 Title="{Binding LabelTitle}" Episode="{Binding LabelEpisode}" HeadLamp="{Binding HeadLamp}" />
                    <Border CornerRadius="10" Background="{DynamicResource SR.DeckWindow}" BorderBrush="Black" BorderThickness="2"
                            Visibility="{Binding IsTapeLoaded, Converter={StaticResource Hidden}}">
                        <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="13" Tracking="0.3" Text="No tape"
                                        Foreground="{DynamicResource SR.SilkLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </ContentControl>

            <!-- The episode percent, and the time left on the show and the queue together -->
            <ContentControl Style="{StaticResource SR.Readout}" Padding="14,7,14,6" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel AutomationProperties.Name="{Binding EpisodeCounterName}" ToolTip="{Binding EpisodeDetail}">
                        <StackPanel Orientation="Horizontal">
                            <sr:SevenSegmentDisplay Text="{Binding PercentDigits}" DigitHeight="24" Spacing="3" Glow="True" />
                            <sr:TrackedText Style="{StaticResource Unit}" Text="%" />
                        </StackPanel>
                        <sr:TrackedText Style="{StaticResource PlateLabel}" Text="Episode" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" AutomationProperties.Name="{Binding RunLeftName}" ToolTip="{Binding RunLeftDetail}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <sr:SevenSegmentDisplay Text="{Binding RunLeftHourDigits}" DigitHeight="24" Spacing="3" Glow="True" />
                            <sr:TrackedText Style="{StaticResource Unit}" Text="H" />
                            <sr:SevenSegmentDisplay Text="{Binding RunLeftMinuteDigits}" DigitHeight="24" Spacing="3" Glow="True" Margin="8,0,0,0" />
                            <sr:TrackedText Style="{StaticResource Unit}" Text="M" />
                        </StackPanel>
                        <sr:TrackedText Style="{StaticResource PlateLabel}" Text="Run left" HorizontalAlignment="Right" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </StackPanel>
    </ContentControl>
</Window>
