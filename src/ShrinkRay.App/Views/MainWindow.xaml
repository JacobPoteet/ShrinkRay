<Window x:Class="ShrinkRay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sr="urn:shrinkray-theme"
        xmlns:vm="clr-namespace:ShrinkRay.App.ViewModels"
        xmlns:ctl="clr-namespace:ShrinkRay.App.Controls"
        xmlns:views="clr-namespace:ShrinkRay.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ShrinkRay"
        Icon="pack://application:,,,/Assets/Icon/ShrinkRay.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SR.ChassisSurface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DeckStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Option chips in the service panel: the lamp lights on the chosen one -->
            <Style x:Key="OptionChip" TargetType="sr:SeasonChip">
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Lamp" Value="Active" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Earlier and later keys for the encode window times -->
            <Geometry x:Key="StepEarlier">M9,1.5 L2.5,6 L9,10.5 Z</Geometry>
            <Geometry x:Key="StepLater">M3,1.5 L9.5,6 L3,10.5 Z</Geometry>
            <Style x:Key="StepKey" TargetType="Button" BasedOn="{StaticResource SR.HardwareKey}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PlateLabel" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.SilkOnPlate}">
                <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- The small lit H and M after the time-left digits, on their baseline -->
            <Style x:Key="TimeUnit" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.Silk}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Tracking" Value="0" />
                <Setter Property="Margin" Value="7,0,0,2" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Foreground" Value="{DynamicResource SR.Phosphor}" />
                <Setter Property="Effect" Value="{DynamicResource SR.PhosphorTextGlow}" />
            </Style>

            <!-- The light a lit readout throws on the plate behind it -->
            <Style x:Key="Spill" TargetType="Rectangle">
                <Setter Property="Fill" Value="{DynamicResource SR.PhosphorSpill}" />
                <Setter Property="Margin" Value="-44,-28" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <Style x:Key="Pixel" TargetType="TextBlock" BasedOn="{StaticResource SR.Text.Pixel}" />

            <!-- One J-card line -->
            <DataTemplate x:Key="TrackRow" DataType="{x:Type vm:TrackViewModel}">
                <Grid Height="31" Background="Transparent" ToolTip="{Binding Detail}" ToolTipService.IsEnabled="{Binding Detail, Converter={StaticResource NotEmpty}}"
                      AutomationProperties.Name="{Binding AutomationName}">
                    <Rectangle Fill="{DynamicResource SR.PhosphorRowTint}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Progress}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Border BorderBrush="{DynamicResource SR.JCardRule}" BorderThickness="0,0,0,1" />
                    <Grid Margin="0,0,10,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="Stripe" Fill="{DynamicResource SR.StripeQueued}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Code}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SR.CardInk}" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource SR.CardInkSoft}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Pixel}" Text="{Binding SizeText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SR.CardInkSoft}" />
                        <sr:TrackedText x:Name="Status" Grid.Column="4" Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="12" Tracking="0.1" Foreground="{DynamicResource SR.CardInkFaint}" />
                        <!-- A file replaced while you watch gets its saving stamped on the card -->
                        <sr:StampMark x:Name="Stamp" Grid.Column="4" IsPressing="{Binding IsStamping}" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                            <sr:TrackedText Text="{Binding StatusText}" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="13"
                                            Tracking="0.1" Foreground="{DynamicResource SR.CardDoneInk}" />
                        </sr:StampMark>
                    </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Shrunk">
                        <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.StripeDone}" />
                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SR.CardDoneInk}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Encoding">
                        <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.Phosphor}" />
                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SR.CardInk}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Kept">
                        <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.StripeKept}" />
                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SR.CardInkSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                        <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.StripeSkipped}" />
                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SR.CardInkSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Failed">
                        <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.StripeFailed}" />
                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SR.CardFailInk}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStamped}" Value="True">
                        <Setter TargetName="Status" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Stamp" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DismissCardCommand}" />
    </Window.InputBindings>

    <!-- The deck is drawn for 1440 by 900. A smaller window scales it down evenly instead of clipping it. -->
    <ctl:DeckScaler x:Name="Scaler" DesignWidth="1440" DesignHeight="900">
    <ContentControl x:Name="Chassis" Style="{StaticResource SR.Chassis}">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <!-- ============ HEADER ============ -->
                <DockPanel Grid.Row="0" LastChildFill="False" VerticalAlignment="Center">
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource SR.Nameplate}" Height="52" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <sr:StripeBadge StripeHeight="32" VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="21" Tracking="0.28" Text="ShrinkRay"
                                                Foreground="{DynamicResource SR.CreamInk}" />
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" FontSize="10" Tracking="0.3"
                                                Text="SR-265 · HEVC transcoder unit" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                    <sr:VentGrille DockPanel.Dock="Left" Width="150" Height="26" Margin="18,0,0,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnMinimize" AutomationProperties.Name="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Minimize}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnMaximize" Margin="7,0,0,0" AutomationProperties.Name="Maximize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Maximize}" Stroke="{DynamicResource SR.Ink}" StrokeThickness="1.6" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnClose" Margin="7,0,0,0" AutomationProperties.Name="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Close}" Stroke="{DynamicResource SR.Ink}" StrokeThickness="1.8" Width="12" Height="12" Stretch="None" />
                        </Button>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Setup" Margin="0,0,18,0" VerticalAlignment="Center"
                            Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open the service panel"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <sr:Lamp DockPanel.Dock="Right" Style="{StaticResource PanelLamp}" Margin="0,0,18,0" VerticalAlignment="Center"
                             Content="{Binding RunLamp.Label}" State="{Binding RunLamp.State}" Blink="{Binding RunLamp.Blink}"
                             ToolTip="{Binding AttentionDetail}" ToolTipService.IsEnabled="{Binding AttentionDetail, Converter={StaticResource NotEmpty}}"
                             WindowChrome.IsHitTestVisibleInChrome="True" />
                </DockPanel>

                <!-- ============ MIDDLE ============ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: show select -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl Style="{StaticResource SR.Bezel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8" Height="29">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="{Binding SortText}"
                                            Command="{Binding ToggleSortCommand}" AutomationProperties.Name="{Binding SortName}"
                                            ToolTip="{Binding SortName}" />
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" Text="Library" VerticalAlignment="Center"
                                                    HorizontalAlignment="Left" ToolTip="{Binding LibraryTooltip}" />
                                </DockPanel>
                                <sr:CrtPanel CornerRadius="24" Padding="6,14,6,10" TubeShadow="50">
                                    <DockPanel>
                                        <!-- Type part of a name to narrow the list. Escape clears it. -->
                                        <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                                            <TextBlock Text="FIND" Opacity="0.4" IsHitTestVisible="False"
                                                       Visibility="{Binding Search, Converter={StaticResource Empty}}" />
                                            <TextBox Style="{StaticResource CrtSearch}"
                                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Find a show by name">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>

                                        <!-- Empty states and the scan count print here; the line is gone when there is nothing to say -->
                                        <TextBlock DockPanel.Dock="Top" Margin="10,0,10,8" Opacity="0.8" Text="{Binding MonitorMessage}"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding MonitorMessage, Converter={StaticResource NotEmpty}}" />

                                        <TextBlock DockPanel.Dock="Bottom" Margin="10,6,10,0" Opacity="0.55" Text="{Binding MonitorNotice}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="66" ToolTip="{Binding Notice}"
                                                   Visibility="{Binding MonitorNotice, Converter={StaticResource NotEmpty}}" />
                                        <!-- The latest failure in the deck's show; the full reason is on hover -->
                                        <TextBlock DockPanel.Dock="Bottom" Margin="10,6,10,0" Opacity="0.9" Text="{Binding LastFailureText}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"
                                                   ToolTip="{Binding LastFailureDetail}" AutomationProperties.Name="{Binding LastFailureDetail}"
                                                   Visibility="{Binding LastFailureText, Converter={StaticResource NotEmpty}}" />

                                        <!-- What runs after the show on the tape; the shows are named on hover -->
                                        <TextBlock DockPanel.Dock="Bottom" Margin="10,6,10,0" Opacity="0.8" Text="{Binding QueueLine}"
                                                   TextWrapping="Wrap" MaxHeight="44" ToolTip="{Binding QueueDetail}"
                                                   Visibility="{Binding QueueLine, Converter={StaticResource NotEmpty}}" />

                                        <ListBox x:Name="ShowList" Style="{StaticResource SR.CrtListBox}" ItemsSource="{Binding VisibleShows}"
                                                 PreviewMouseRightButtonDown="OnShowRightDown"
                                                 SelectedItem="{Binding SelectedShow}" AutomationProperties.Name="Shows to shrink">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SR.CrtListBoxItem}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                                                    <Setter Property="ContextMenu">
                                                        <Setter.Value>
                                                            <ContextMenu Style="{StaticResource DeckMenu}">
                                                                <MenuItem Style="{StaticResource DeckMenuItem}" Header="{Binding QueueText}"
                                                                          Command="{Binding QueueCommand}" />
                                                            </ContextMenu>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShowRowViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Mark}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding ColumnText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </sr:CrtPanel>
                            </DockPanel>
                        </ContentControl>

                    </Grid>

                    <!-- Centre: transport -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="280" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="84" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="138" />
                        </Grid.RowDefinitions>

                        <ContentControl Style="{StaticResource SR.Plate}" Padding="12,12">
                            <Grid Width="640" Height="256" AutomationProperties.Name="{Binding DeckAutomationName}">
                                <Canvas Visibility="{Binding IsTapeLoaded, Converter={StaticResource Visible}}">
                                    <Rectangle Canvas.Left="40" Canvas.Top="66" Width="560" Height="168" RadiusX="16" RadiusY="16"
                                               Fill="{DynamicResource SR.DeckWindow}" Stroke="Black" StrokeThickness="2" />
                                    <Rectangle Canvas.Left="44" Canvas.Top="70" Width="552" Height="40" RadiusX="12" RadiusY="12" Fill="#09FFFFFF" />
                                    <sr:TapeReel Canvas.Left="96" Canvas.Top="66" Width="168" Height="168" SecondsPerTurn="3.2"
                                                 Pack="{Binding SourcePack}" IsSpinning="{Binding IsSpinning}" AutomationProperties.Name="Source reel" />
                                    <sr:TapeReel Canvas.Left="376" Canvas.Top="66" Width="168" Height="168" SecondsPerTurn="2.1"
                                                 Pack="{Binding OutputPack}" IsSpinning="{Binding IsSpinning}" AutomationProperties.Name="Output reel" />
                                    <ctl:TapePath Width="640" Height="256" SourcePack="{Binding SourcePack}" OutputPack="{Binding OutputPack}" IsHitTestVisible="False" />
                                    <Ellipse Canvas.Left="245" Canvas.Top="237" Width="14" Height="14" Fill="{DynamicResource SR.Roller}" Stroke="#3A3833" />
                                    <Ellipse Canvas.Left="381" Canvas.Top="237" Width="14" Height="14" Fill="{DynamicResource SR.Roller}" Stroke="#3A3833" />
                                    <!-- The encoder head on the tape run; its lamp lights while NVENC is working -->
                                    <Grid Canvas.Left="282" Canvas.Top="237" Width="76" Height="19">
                                        <Border CornerRadius="3" Background="{DynamicResource SR.PartFill}" BorderBrush="#3A3833" BorderThickness="1" />
                                        <Border Margin="1" CornerRadius="2" BorderThickness="0,1,0,0" BorderBrush="#80FFFFFF" />
                                        <sr:Lamp Style="{StaticResource PanelLamp}" Diameter="8" Spacing="6" Content="NVENC" Foreground="{DynamicResource SR.PartInk}"
                                                 State="{Binding HeadLamp}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <sr:CassetteLabel Canvas.Left="56" Canvas.Top="4" Width="528" Height="56" Padding="16,4,14,4"
                                                      Title="{Binding LabelTitle}" Episode="{Binding LabelEpisode}"
                                                      EpisodeTitle="{Binding LabelEpisodeTitle}" />
                                    <sr:TrackedText Canvas.Left="58" Canvas.Top="210" Style="{StaticResource SR.SilkOnPlate}" FontSize="12" Tracking="0.16"
                                                    Text="{Binding SourceCaption}" ToolTip="{Binding SourceDetail}" />
                                    <Grid Canvas.Left="0" Canvas.Top="210" Width="582">
                                        <sr:TrackedText HorizontalAlignment="Right" Style="{StaticResource SR.Silk}" FontSize="12" Tracking="0.16"
                                                        Foreground="{DynamicResource SR.Phosphor}" Effect="{DynamicResource SR.PhosphorTextGlow}"
                                                        Text="{Binding OutputCaption}" ToolTip="{Binding OutputDetail}" />
                                    </Grid>
                                </Canvas>
                                <Border CornerRadius="16" Background="{DynamicResource SR.DeckWindow}" BorderBrush="Black" BorderThickness="2"
                                        Visibility="{Binding IsTapeLoaded, Converter={StaticResource Hidden}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="16" Tracking="0.3" Text="No tape"
                                                        Foreground="{DynamicResource SR.SilkLight}" HorizontalAlignment="Center" />
                                        <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Tracking="0.14" Margin="0,12,0,0" HorizontalAlignment="Center"
                                                        Text="Pick a show from the library" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ContentControl>

                        <!-- Readouts: where the current episode is, and how long the whole show has left -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource SR.Readout}" Padding="18,8" ToolTip="{Binding EpisodeDetail}"
                                            AutomationProperties.Name="{Binding EpisodeCounterName}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                                        <sr:TrackedText DockPanel.Dock="Left" Style="{StaticResource PlateLabel}" Text="Episode" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SR.LedSlot}" Padding="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <sr:LedBar Fraction="{Binding EpisodeFraction}" Segments="28" Height="6" Gap="2" Glow="True"
                                                       AutomationProperties.Name="Episode progress" />
                                        </Border>
                                    </DockPanel>
                                    <!-- Speed and tape position, small beside the percent -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel>
                                            <sr:SevenSegmentDisplay Text="{Binding FpsDigits}" DigitHeight="20" Spacing="2" Glow="True"
                                                                    HorizontalAlignment="Right" AutomationProperties.Name="Frames per second" />
                                            <sr:TrackedText Style="{StaticResource PlateLabel}" Text="Frames / s" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="18,0,0,0">
                                            <sr:SevenSegmentDisplay Text="{Binding TapeTimeDigits}" DigitHeight="20" Spacing="2" Glow="True"
                                                                    HorizontalAlignment="Right" AutomationProperties.Name="Tape time" />
                                            <sr:TrackedText Style="{StaticResource PlateLabel}" Text="Tape time" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Rectangle Style="{StaticResource Spill}" />
                                        <StackPanel Orientation="Horizontal">
                                            <sr:SevenSegmentDisplay Text="{Binding PercentDigits}" DigitHeight="40" Spacing="4" Glow="True" />
                                            <sr:TrackedText Style="{StaticResource SR.Silk}" FontSize="26" FontWeight="Bold" Tracking="0" Text="%" Margin="10,0,0,2"
                                                            VerticalAlignment="Bottom" Foreground="{DynamicResource SR.Phosphor}"
                                                            Effect="{DynamicResource SR.PhosphorTextGlow}" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Style="{StaticResource SR.Readout}" Padding="22,8" ToolTip="{Binding ShowLeftDetail}"
                                            AutomationProperties.Name="{Binding ShowLeftName}">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Show left" Margin="0,5,0,0" />
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Rectangle Style="{StaticResource Spill}" />
                                        <StackPanel Orientation="Horizontal">
                                            <sr:SevenSegmentDisplay Text="{Binding ShowLeftHourDigits}" DigitHeight="40" Spacing="4" Glow="True" />
                                            <sr:TrackedText Style="{StaticResource TimeUnit}" Text="H" />
                                            <sr:SevenSegmentDisplay Text="{Binding ShowLeftMinuteDigits}" DigitHeight="40" Spacing="4" Glow="True"
                                                                    Margin="16,0,0,0" />
                                            <sr:TrackedText Style="{StaticResource TimeUnit}" Text="M" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </ContentControl>
                        </Grid>

                        <!-- Transport keys -->
                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <sr:PianoLatchKey x:Name="EncodeKey" Label="Encode" IsRecord="True" ShowLamp="True" MinWidth="0" VerticalAlignment="Top"
                                              Icon="{StaticResource SR.Icon.Record}" IsChecked="{Binding IsEncoding, Mode=OneWay}"
                                              Lamp="{Binding EncodeLamp}" LampBlink="{Binding EncodeLampBlink}"
                                              Command="{Binding EncodeCommand}" Click="OnLatchClick" AutomationProperties.Name="Start encoding" ToolTip="Start encoding" />
                            <sr:PianoLatchKey x:Name="PauseKey" Grid.Column="2" Label="Pause" MinWidth="0" VerticalAlignment="Top"
                                              Icon="{StaticResource SR.Icon.Pause}" IsChecked="{Binding IsPaused, Mode=OneWay}"
                                              Command="{Binding PauseCommand}" Click="OnLatchClick" AutomationProperties.Name="Pause the encode" ToolTip="Pause the encode" />
                            <!-- Latched, with a blinking lamp, while the run is set to end after this episode -->
                            <sr:PianoLatchKey x:Name="StopKey" Grid.Column="4" Label="Stop" ShowLamp="True" MinWidth="0" VerticalAlignment="Top"
                                              Icon="{StaticResource SR.Icon.Stop}" IsChecked="{Binding IsStopArmed, Mode=OneWay}"
                                              Lamp="{Binding StopLamp}" LampBlink="{Binding StopLampBlink}"
                                              Command="{Binding StopCommand}" Click="OnLatchClick"
                                              AutomationProperties.Name="{Binding StopKeyName}" ToolTip="{Binding StopKeyName}" />
                            <sr:PianoKey Grid.Column="6" Label="Skip" MinWidth="0" VerticalAlignment="Top" Icon="{StaticResource SR.Icon.Skip}"
                                         Command="{Binding SkipCommand}" AutomationProperties.Name="Skip this episode" ToolTip="Skip this episode" />
                        </Grid>

                        <!-- Tour: the Encode key -->
                        <sr:CoachMark x:Name="EncodeMark" Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,-8"
                                      Pointer="Bottom" PointerOffset="66" Step="2 of 3" Text="{Binding TourEncodeText}"
                                      NextCommand="{Binding SetupNextCommand}" SkipCommand="{Binding SkipTourCommand}"
                                      Visibility="{Binding IsTourEncode, Converter={StaticResource Visible}}" />

                        <!-- Meters -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource SR.Bezel}" Padding="9" ToolTip="Output video bitrate, megabits per second">
                                <sr:VuMeter Height="Auto" MinWidth="0" Caption="Mbps" Minimum="0" Maximum="8" MinLabel="0" MidLabel="4" MaxLabel="8"
                                            Value="{Binding BitrateMbps}" AutomationProperties.Name="Output video bitrate, megabits per second" />
                            </ContentControl>
                            <ContentControl Grid.Column="2" Style="{StaticResource SR.Bezel}" Padding="9" ToolTip="NVENC encoder load, percent">
                                <sr:VuMeter Height="Auto" MinWidth="0" Caption="Load" Minimum="0" Maximum="100" MinLabel="0" MidLabel="50" MaxLabel="100"
                                            Value="{Binding EncoderLoad}" AutomationProperties.Name="NVENC encoder load, percent" />
                            </ContentControl>
                        </Grid>
                    </Grid>

                    <!-- Right: J-card -->
                    <Grid Grid.Column="4">
                        <ContentControl Style="{StaticResource SR.Bezel}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,4,8" Height="20" ClipToBounds="True">
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" Text="{Binding TracksHeading}" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Browsing another show during a run: the tape and the run stay with the show that is encoding.
                                     The queue key puts the listed show in line behind it. -->
                                <WrapPanel DockPanel.Dock="Top">
                                    <Button Style="{StaticResource TextKey}" Content="{Binding QueueKeyText}" Margin="0,0,8,8"
                                            Command="{Binding ToggleQueueCommand}" AutomationProperties.Name="{Binding QueueKeyText}"
                                            Visibility="{Binding CanQueueShown, Converter={StaticResource Visible}}" />
                                    <Button Style="{StaticResource TextKey}" Content="{Binding BackText}" Margin="0,0,0,8"
                                            Command="{Binding BackToRunCommand}" AutomationProperties.Name="{Binding BackText}"
                                            Visibility="{Binding IsBrowsing, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Seasons}" Margin="0,0,0,6" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SeasonChipViewModel}">
                                            <sr:SeasonChip GroupName="seasons" Content="{Binding Label}" Width="34" Margin="0,0,3.5,4"
                                                           IsChecked="{Binding IsSelected}" Lamp="{Binding Lamp}" LampBlink="{Binding Blink}"
                                                           AutomationProperties.Name="{Binding AutomationName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border CornerRadius="6" Background="{DynamicResource SR.JCard}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Height="20" Margin="0,2,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <sr:TrackedText Grid.Column="1" Text="Ep" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="{DynamicResource SR.CardInkFaint}" VerticalAlignment="Center" />
                                            <sr:TrackedText Grid.Column="2" Text="Title" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="{DynamicResource SR.CardInkFaint}" VerticalAlignment="Center" />
                                            <sr:TrackedText Grid.Column="3" Text="GB" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="{DynamicResource SR.CardInkFaint}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <sr:TrackedText Grid.Column="4" Text="Status" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="{DynamicResource SR.CardInkFaint}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SR.JCardRule}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" PanningMode="VerticalOnly">
                                            <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackRow}" Focusable="False"
                                                          AutomationProperties.Name="Episodes in this season" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </ContentControl>
                    </Grid>

                    <!-- Tour: the library list -->
                    <sr:CoachMark x:Name="LibraryMark" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,72,0,0"
                                  Pointer="Left" PointerOffset="28" Step="1 of 3" Text="Pick a show."
                                  NextCommand="{Binding SetupNextCommand}" SkipCommand="{Binding SkipTourCommand}"
                                  Visibility="{Binding IsTourLibrary, Converter={StaticResource Visible}}" />
                    <!-- Tour: the savings along the bottom -->
                    <sr:CoachMark x:Name="SavingsMark" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,-18"
                                  Pointer="Bottom" PointerOffset="80" Step="3 of 3" Text="Watch the space come back here."
                                  NextLabel="Done" NextCommand="{Binding SetupNextCommand}"
                                  Visibility="{Binding IsTourSavings, Converter={StaticResource Visible}}" />
                </Grid>

                <!-- ============ FOOTER ============ -->
                <ContentControl Grid.Row="4" Style="{StaticResource SR.Readout}" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Text="Saved · this show" VerticalAlignment="Center" />
                                <!-- Blinks for a few seconds each time a smaller file takes an original's place -->
                                <sr:Lamp Style="{StaticResource PanelLamp}" Foreground="{DynamicResource SR.SilkLight}" Margin="18,0,0,0"
                                         VerticalAlignment="Center" Content="BANKED" State="{Binding BankedLamp}" Blink="{Binding IsBanked}" />
                            </StackPanel>
                            <Grid HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Rectangle Style="{StaticResource Spill}" />
                                <StackPanel Orientation="Horizontal">
                                    <sr:SevenSegmentDisplay Text="{Binding SavedDigits}" Roll="{Binding SavedRoll}" DigitHeight="74" Spacing="5"
                                                            Glow="True" AutomationProperties.Name="Gigabytes saved in this show" />
                                    <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="22" Tracking="0" Text="GB" Margin="14,0,0,6"
                                                    VerticalAlignment="Bottom" Foreground="{DynamicResource SR.Phosphor}"
                                                    Effect="{DynamicResource SR.PhosphorTextGlow}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Text="Saved · all time" />
                            <Grid HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Rectangle Style="{StaticResource Spill}" />
                                <StackPanel Orientation="Horizontal">
                                    <sr:SevenSegmentDisplay Text="{Binding LifetimeSavedDigits}" Roll="{Binding LifetimeSavedRoll}" DigitHeight="74"
                                                            Spacing="5" Glow="True" AutomationProperties.Name="{Binding LifetimeSavedName}" />
                                    <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="22" Tracking="0" Text="{Binding LifetimeSavedUnit}"
                                                    Margin="14,0,0,6" VerticalAlignment="Bottom" Foreground="{DynamicResource SR.Phosphor}"
                                                    Effect="{DynamicResource SR.PhosphorTextGlow}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- One bar: the lit LEDs are what the show weighs after, the dark ones are what it gives back -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <Border Style="{StaticResource SR.LedSlot}">
                                <sr:LedBar Fraction="{Binding AfterFraction}" Segments="40" Height="18" Glow="True"
                                           AutomationProperties.Name="{Binding SizeCaption}" />
                            </Border>
                            <!-- The pixel and silk fonts have no arrow glyph, so the caption's arrow is drawn -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.Name="{Binding SizeCaption}">
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" FontSize="14" Text="{Binding SizeBeforeText}" />
                                <Path Data="M0,5 L14,5 M9,1 L14,5 L9,9" Stroke="{DynamicResource SR.SilkLight}" StrokeThickness="1.6" Width="14" Height="10"
                                      Margin="9,0,9,0" VerticalAlignment="Center"
                                      Visibility="{Binding SizeBeforeText, Converter={StaticResource NotEmpty}}" />
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" FontSize="14" Text="{Binding SizeAfterText}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <!-- ============ FIRST-RUN SETUP ============ -->
                <views:SetupCards x:Name="SetupCards" Grid.Row="1" Grid.RowSpan="4" Margin="-22,0,-22,-18" />
            </Grid>

            <!-- ============ SERVICE PANEL ============ -->
            <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}" Margin="-22,-18">
                <Rectangle Fill="#8C000000" MouseDown="OnScrimDown" />
                <ContentControl Style="{StaticResource SR.Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                    <StackPanel>
                        <DockPanel>
                            <sr:PianoKey DockPanel.Dock="Right" Label="Close" MinWidth="88" Width="88"
                                         Command="{Binding CloseSettingsCommand}" AutomationProperties.Name="Close the service panel" />
                            <sr:TrackedText Style="{StaticResource SR.Heading}" Text="Service panel" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <sr:TrackedText Style="{StaticResource SR.Silk}" Text="Originals" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <ToggleButton Style="{StaticResource SR.ToggleSwitch}" Content="Replace after checks pass" VerticalAlignment="Center"
                                              IsChecked="{Binding ReplaceOriginals}" IsEnabled="{Binding CanEditSettings}"
                                              AutomationProperties.Name="Replace originals after every check passes" />
                                <sr:DymoLabel Text="Deletes originals" Tape="Red" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- The show in the deck encodes at the chosen CQ. The recommended one is marked, and choosing it clears the show's own setting. -->
                            <sr:TrackedText Grid.Row="1" Style="{StaticResource SR.Silk}" Text="Quality (CQ)" VerticalAlignment="Top" Margin="0,16,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
                                <ItemsControl ItemsSource="{Binding CqChips}" IsEnabled="{Binding CanEditQuality}" Focusable="False"
                                              AutomationProperties.Name="Quality, constant quality value">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CqChipViewModel}">
                                            <sr:SeasonChip GroupName="quality" Style="{StaticResource OptionChip}" Content="{Binding Label}" MinWidth="44"
                                                           Margin="0,0,6,6" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding AutomationName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SR.Text.Caption}" Text="{Binding CqCaption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="2" Style="{StaticResource SR.Silk}" Text="Fonts" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="2" Grid.Column="1" Style="{StaticResource SR.ToggleSwitch}" Margin="0,6" HorizontalAlignment="Left"
                                          Content="Restore MKV fonts if an encode drops them" IsChecked="{Binding RestoreFonts}"
                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="Restore fonts" />

                            <sr:TrackedText Grid.Row="3" Style="{StaticResource SR.Silk}" Text="Audio" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="3" Grid.Column="1" Style="{StaticResource SR.ToggleSwitch}" Margin="0,6" HorizontalAlignment="Left"
                                          Content="Keep lossless tracks (FLAC, TrueHD, DTS-HD)" IsChecked="{Binding KeepLosslessAudio}"
                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="Keep lossless audio" />

                            <sr:TrackedText Grid.Row="4" Style="{StaticResource SR.Silk}" Text="Encode window" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="4" Grid.Column="1" Style="{StaticResource SR.ToggleSwitch}" Margin="0,6" HorizontalAlignment="Left"
                                          IsChecked="{Binding EncodeWindowEnabled}" IsEnabled="{Binding CanEditSettings}"
                                          AutomationProperties.Name="Only start episodes inside the encode window">
                                <TextBlock><Run Text="Only start episodes during " /><Run Text="{Binding WindowText, Mode=OneWay}" /></TextBlock>
                            </ToggleButton>

                            <!-- The times only matter while the window is on -->
                            <sr:TrackedText Grid.Row="5" Style="{StaticResource SR.Silk}" Text="Window times" VerticalAlignment="Center"
                                            Visibility="{Binding EncodeWindowEnabled, Converter={StaticResource Visible}}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6"
                                        Visibility="{Binding EncodeWindowEnabled, Converter={StaticResource Visible}}">
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowStartEarlierCommand}"
                                        AutomationProperties.Name="Open the window half an hour earlier">
                                    <Path Data="{StaticResource StepEarlier}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <ContentControl Style="{StaticResource SR.Readout}" Padding="10,6" Margin="6,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Window opens">
                                    <sr:SevenSegmentDisplay Text="{Binding WindowStartText}" DigitHeight="18" Spacing="2" Glow="True"
                                                            AutomationProperties.Name="{Binding WindowStartText}" />
                                </ContentControl>
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowStartLaterCommand}"
                                        AutomationProperties.Name="Open the window half an hour later">
                                    <Path Data="{StaticResource StepLater}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <sr:TrackedText Style="{StaticResource SR.Silk}" Text="to" VerticalAlignment="Center" Margin="14,0" />
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowEndEarlierCommand}"
                                        AutomationProperties.Name="Close the window half an hour earlier">
                                    <Path Data="{StaticResource StepEarlier}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <ContentControl Style="{StaticResource SR.Readout}" Padding="10,6" Margin="6,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Window closes">
                                    <sr:SevenSegmentDisplay Text="{Binding WindowEndText}" DigitHeight="18" Spacing="2" Glow="True"
                                                            AutomationProperties.Name="{Binding WindowEndText}" />
                                </ContentControl>
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowEndLaterCommand}"
                                        AutomationProperties.Name="Close the window half an hour later">
                                    <Path Data="{StaticResource StepLater}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                            </StackPanel>

                            <sr:TrackedText Grid.Row="6" Style="{StaticResource SR.Silk}" Text="Phosphor" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                <sr:SeasonChip GroupName="phosphor" Content="AMBER" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorAmber}" />
                                <sr:SeasonChip GroupName="phosphor" Content="GREEN" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorGreen}" />
                                <sr:SeasonChip GroupName="phosphor" Content="ICE" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorIce}" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="7" Style="{StaticResource SR.Silk}" Text="Chassis" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                <sr:SeasonChip GroupName="chassis" Content="BEIGE" Style="{StaticResource OptionChip}" MinWidth="96" IsChecked="{Binding ChassisBeige}" />
                                <sr:SeasonChip GroupName="chassis" Content="GRAPHITE" Style="{StaticResource OptionChip}" MinWidth="96" IsChecked="{Binding ChassisGraphite}" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="8" Style="{StaticResource SR.Silk}" Text="Library" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Choose" Command="{Binding ChooseLibraryCommand}"
                                        AutomationProperties.Name="Choose the library folder" />
                                <TextBlock Style="{StaticResource SR.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,10,0" Text="{Binding LibraryRoot}" ToolTip="{Binding LibraryRoot}" />
                            </DockPanel>

                            <sr:TrackedText Grid.Row="9" Style="{StaticResource SR.Silk}" Text="Scratch" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Choose" Command="{Binding ChooseScratchCommand}"
                                        AutomationProperties.Name="Choose the local scratch folder" />
                                <TextBlock Style="{StaticResource SR.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,10,0" Text="{Binding ScratchFolder}" ToolTip="{Binding ScratchFolder}" />
                            </DockPanel>

                            <sr:TrackedText Grid.Row="10" Style="{StaticResource SR.Silk}" Text="Setup" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                <Button Style="{StaticResource TextKey}" Content="Run setup again" Command="{Binding RunSetupAgainCommand}"
                                        AutomationProperties.Name="Run setup again" />
                                <Button Style="{StaticResource TextKey}" Content="Show the tour" Margin="10,0,0,0" Command="{Binding ShowTourCommand}"
                                        AutomationProperties.Name="Show the tour" />
                                <Button Style="{StaticResource TextKey}" Content="Open the log" Margin="10,0,0,0" Command="{Binding OpenLogCommand}"
                                        AutomationProperties.Name="Show the log file in Explorer" />
                            </StackPanel>

                            <!-- What the header lamp watches, one lamp per tool -->
                            <sr:TrackedText Grid.Row="11" Style="{StaticResource SR.Silk}" Text="System" VerticalAlignment="Top" Margin="0,14,0,0" />
                            <ItemsControl Grid.Row="11" Grid.Column="1" Margin="0,12,0,4" Focusable="False" ItemsSource="{Binding SystemLamps}"
                                          ItemTemplate="{StaticResource LampItem}" AutomationProperties.Name="System status">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,14,6" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,14,0,0" Text="{Binding Notice}"
                                   Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ============ STOP CARD ============ -->
            <!-- Stop mid-episode asks first. Escape or a click outside dismisses it and changes nothing. -->
            <Grid x:Name="StopOverlay" Visibility="{Binding IsStopCardOpen, Converter={StaticResource Visible}}" Margin="-22,-18">
                <Rectangle Fill="#8C000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCardCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>
                <ContentControl Style="{StaticResource SR.Card}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22"
                                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                                AutomationProperties.Name="Stop the encode">
                    <StackPanel>
                        <sr:TrackedText Style="{StaticResource SR.Heading}" Text="{Binding StopCardHeading}" />
                        <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,10,0,0" FontSize="14" Text="{Binding StopCardText}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <sr:PianoKey x:Name="StopPrimaryKey" Label="{Binding StopPrimaryLabel}" MinWidth="190" Width="190"
                                         Command="{Binding StopPrimaryCommand}" AutomationProperties.Name="{Binding StopPrimaryName}" />
                            <sr:PianoKey Label="Stop now" MinWidth="130" Width="130" Margin="14,0,0,0"
                                         Command="{Binding StopNowCommand}" AutomationProperties.Name="Stop now and discard this encode" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ============ CLOSE CONFIRM ============ -->
            <!-- Closing during a run asks first. Escape keeps running; once confirmed, the card shows the wait. -->
            <Grid x:Name="CloseOverlay" Visibility="{Binding IsCloseOverlayOpen, Converter={StaticResource Visible}}" Margin="-22,-18">
                <Rectangle Fill="#8C000000" />
                <ContentControl Style="{StaticResource SR.Card}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22"
                                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                                AutomationProperties.Name="Close ShrinkRay during a run">
                    <StackPanel>
                        <sr:TrackedText Style="{StaticResource SR.Heading}" Text="{Binding CloseHeading}" />
                        <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,10,0,0" FontSize="14" Text="{Binding CloseText}" />
                        <ContentControl Style="{StaticResource SR.Plate}" Margin="0,18,0,0" Padding="14,10" HorizontalAlignment="Left">
                            <sr:Lamp Style="{StaticResource PanelLamp}" Foreground="{DynamicResource SR.SilkLight}"
                                     Content="{Binding RunLamp.Label}" State="{Binding RunLamp.State}" Blink="{Binding RunLamp.Blink}" />
                        </ContentControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"
                                    Visibility="{Binding IsCloseConfirmOpen, Converter={StaticResource Visible}}">
                            <sr:PianoKey x:Name="KeepRunningKey" Label="Keep running" MinWidth="150" Width="150"
                                         Command="{Binding CancelCloseCommand}" AutomationProperties.Name="Keep running and leave ShrinkRay open" />
                            <sr:PianoKey Label="Close after this episode" MinWidth="220" Width="220" Margin="14,0,0,0"
                                         Visibility="{Binding CanCloseAfterEpisode, Converter={StaticResource Visible}}"
                                         Command="{Binding CloseAfterEpisodeCommand}"
                                         AutomationProperties.Name="Let this episode finish, then close ShrinkRay" />
                            <sr:PianoKey Label="{Binding CloseKeyLabel}" MinWidth="150" Width="150" Margin="14,0,0,0"
                                         Command="{Binding ConfirmCloseCommand}" AutomationProperties.Name="{Binding CloseKeyLabel}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </ContentControl>
    </ctl:DeckScaler>
</Window>
