<Window x:Class="ShrinkRay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sr="urn:shrinkray-theme"
        xmlns:vm="clr-namespace:ShrinkRay.App.ViewModels"
        xmlns:ctl="clr-namespace:ShrinkRay.App.Controls"
        xmlns:views="clr-namespace:ShrinkRay.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ShrinkRay"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SR.ChassisSurface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:InverseVisibilityConverter x:Key="Hidden" />
        <views:EmptyToCollapsedConverter x:Key="NotEmpty" />

        <!-- A lamp with a silkscreen word, as printed on the panel -->
        <DataTemplate x:Key="SilkWord">
            <sr:TrackedText Text="{Binding}" Style="{StaticResource SR.Silk}" FontSize="11" Tracking="0.12"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=sr:Lamp}}" />
        </DataTemplate>

        <Style x:Key="PanelLamp" TargetType="sr:Lamp">
            <Setter Property="Diameter" Value="9" />
            <Setter Property="Spacing" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
            <Setter Property="ContentTemplate" Value="{StaticResource SilkWord}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        </Style>

        <DataTemplate x:Key="LampItem" DataType="{x:Type vm:LampViewModel}">
            <sr:Lamp Style="{StaticResource PanelLamp}" Content="{Binding Label}" State="{Binding State}" Blink="{Binding Blink}" />
        </DataTemplate>

        <!-- Small text keycap for Choose, Setup and friends -->
        <Style x:Key="TextKey" TargetType="Button" BasedOn="{StaticResource SR.HardwareKey}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <sr:TrackedText Text="{Binding}" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                        Tracking="0.16" Foreground="{DynamicResource SR.Ink}" Margin="10,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A short keycap that fits beside a readout, such as the knob's Reset -->
        <Style x:Key="SmallKey" TargetType="Button" BasedOn="{StaticResource TextKey}">
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <sr:TrackedText Text="{Binding}" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="9"
                                        Tracking="0.14" Foreground="{DynamicResource SR.Ink}" Margin="6,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Option chips in the service panel: the lamp lights on the chosen one -->
        <Style x:Key="OptionChip" TargetType="sr:SeasonChip">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Lamp" Value="Active" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Earlier and later keys for the encode window times -->
        <Geometry x:Key="StepEarlier">M9,1.5 L2.5,6 L9,10.5 Z</Geometry>
        <Geometry x:Key="StepLater">M3,1.5 L9.5,6 L3,10.5 Z</Geometry>
        <Style x:Key="StepKey" TargetType="Button" BasedOn="{StaticResource SR.HardwareKey}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlateLabel" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.SilkOnPlate}">
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="Pixel" TargetType="TextBlock" BasedOn="{StaticResource SR.Text.Pixel}" />

        <!-- One J-card line -->
        <DataTemplate x:Key="TrackRow" DataType="{x:Type vm:TrackViewModel}">
            <Grid Height="31" Background="Transparent" ToolTip="{Binding Detail}" ToolTipService.IsEnabled="{Binding Detail, Converter={StaticResource NotEmpty}}">
                <Rectangle Fill="{DynamicResource SR.PhosphorRowTint}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Progress}" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border BorderBrush="{DynamicResource SR.JCardRule}" BorderThickness="0,0,0,1" />
                <Grid Margin="0,0,10,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="Stripe" Fill="#B4A98F" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Code}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="14" Foreground="#2F2A21" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Medium" FontSize="14" Foreground="#5B5344" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Pixel}" Text="{Binding SizeText}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="#5B5344" />
                    <sr:TrackedText x:Name="Status" Grid.Column="4" Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="12" Tracking="0.1" Foreground="#7A7160" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Shrunk">
                    <Setter TargetName="Stripe" Property="Fill" Value="#7FA63A" />
                    <Setter TargetName="Status" Property="Foreground" Value="#4D6B1E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Encoding">
                    <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource SR.Phosphor}" />
                    <Setter TargetName="Status" Property="Foreground" Value="#2F2A21" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Kept">
                    <Setter TargetName="Stripe" Property="Fill" Value="#8F8670" />
                    <Setter TargetName="Status" Property="Foreground" Value="#5B5344" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                    <Setter TargetName="Stripe" Property="Fill" Value="#6D665A" />
                    <Setter TargetName="Status" Property="Foreground" Value="#5B5344" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                    <Setter TargetName="Stripe" Property="Fill" Value="#2A2824" />
                    <Setter TargetName="Status" Property="Foreground" Value="#2A2824" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCloseCommand}" />
    </Window.InputBindings>

    <!-- The deck is drawn for 1440 by 900. A smaller window scales it down evenly instead of clipping it. -->
    <ctl:DeckScaler x:Name="Scaler" DesignWidth="1440" DesignHeight="900">
    <ContentControl x:Name="Chassis" Style="{StaticResource SR.Chassis}">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <!-- ============ HEADER ============ -->
                <DockPanel Grid.Row="0" LastChildFill="False" VerticalAlignment="Center">
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource SR.Nameplate}" Height="52" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <sr:StripeBadge StripeHeight="32" VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="21" Tracking="0.28" Text="ShrinkRay"
                                                Foreground="{DynamicResource SR.CreamInk}" />
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" FontSize="10" Tracking="0.3"
                                                Text="SR-265 · HEVC transcoder unit" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                    <sr:VentGrille DockPanel.Dock="Left" Width="150" Height="26" Margin="18,0,0,0" />
                    <ItemsControl DockPanel.Dock="Left" Margin="22,0,0,0" VerticalAlignment="Center" Focusable="False"
                                  ItemsSource="{Binding SystemLamps}" ItemTemplate="{StaticResource LampItem}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,16,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnMinimize" AutomationProperties.Name="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Minimize}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnMaximize" Margin="7,0,0,0" AutomationProperties.Name="Maximize"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Maximize}" Stroke="{DynamicResource SR.Ink}" StrokeThickness="1.6" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource SR.HardwareKey}" Click="OnClose" Margin="7,0,0,0" AutomationProperties.Name="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource SR.Icon.Close}" Stroke="{DynamicResource SR.Ink}" StrokeThickness="1.8" Width="12" Height="12" Stretch="None" />
                        </Button>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Setup" Margin="0,0,18,0" VerticalAlignment="Center"
                            Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open the service panel"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <sr:Lamp DockPanel.Dock="Right" Style="{StaticResource PanelLamp}" Margin="0,0,18,0" VerticalAlignment="Center"
                             Content="{Binding RunLamp.Label}" State="{Binding RunLamp.State}" Blink="{Binding RunLamp.Blink}" />
                </DockPanel>

                <!-- ============ MIDDLE ============ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: show select -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl Style="{StaticResource SR.Bezel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8" Height="20">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Choose" Height="22"
                                            Command="{Binding ChooseLibraryCommand}" AutomationProperties.Name="Choose the library folder" />
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" Text="Library · show select" VerticalAlignment="Center" />
                                </DockPanel>
                                <sr:CrtPanel CornerRadius="24" Padding="6,14,6,10" TubeShadow="50">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="10,0,10,8" Opacity="0.8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShowCountText}" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding LibraryLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryRoot}" />
                                        </DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="32,0,10,4" Opacity="0.55">
                                            <TextBlock Text="SHOW" />
                                            <TextBlock Text="GB" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Rectangle DockPanel.Dock="Top" Height="1" Margin="10,0,10,6" Fill="{DynamicResource SR.PhosphorDim}" />

                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CursorInfo}" Margin="10,0" LineHeight="23"
                                                   LineStackingStrategy="BlockLineHeight" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                        <Rectangle DockPanel.Dock="Bottom" Height="1" Margin="10,6" Fill="{DynamicResource SR.PhosphorDim}" />
                                        <StackPanel DockPanel.Dock="Bottom" Margin="32,4,10,0" Opacity="0.55">
                                            <TextBlock Text="{Binding HiddenText}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HiddenText, Converter={StaticResource NotEmpty}}" />
                                            <TextBlock Text="{Binding MonitorMessage}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding MonitorMessage, Converter={StaticResource NotEmpty}}" />
                                            <TextBlock Text="{Binding RecoveryText}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding RecoveryText, Converter={StaticResource NotEmpty}}" />
                                            <TextBlock Text="{Binding MonitorNotice}" TextWrapping="Wrap" MaxHeight="44"
                                                       Visibility="{Binding MonitorNotice, Converter={StaticResource NotEmpty}}" />
                                        </StackPanel>
                                        <!-- The latest failure in the deck's show; the full reason is on hover -->
                                        <TextBlock DockPanel.Dock="Bottom" Margin="32,6,10,0" Opacity="0.9" Text="{Binding LastFailureText}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"
                                                   ToolTip="{Binding LastFailureDetail}" AutomationProperties.Name="{Binding LastFailureDetail}"
                                                   Visibility="{Binding LastFailureText, Converter={StaticResource NotEmpty}}" />

                                        <ListBox x:Name="ShowList" Style="{StaticResource SR.CrtListBox}" ItemsSource="{Binding Shows}"
                                                 SelectedItem="{Binding SelectedShow}" AutomationProperties.Name="Shows to shrink"
                                                 MouseDoubleClick="OnShowDoubleClick" KeyDown="OnShowKeyDown">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SR.CrtListBoxItem}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShowRowViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Mark}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </sr:CrtPanel>
                            </DockPanel>
                        </ContentControl>

                    </Grid>

                    <!-- Centre: transport -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="280" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="74" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="84" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="146" />
                        </Grid.RowDefinitions>

                        <ContentControl Style="{StaticResource SR.Plate}" Padding="12,12">
                            <Grid Width="640" Height="256" AutomationProperties.Name="{Binding DeckAutomationName}">
                                <Canvas Visibility="{Binding IsTapeLoaded, Converter={StaticResource Visible}}">
                                    <Rectangle Canvas.Left="40" Canvas.Top="66" Width="560" Height="168" RadiusX="16" RadiusY="16"
                                               Fill="{DynamicResource SR.DeckWindow}" Stroke="Black" StrokeThickness="2" />
                                    <Rectangle Canvas.Left="44" Canvas.Top="70" Width="552" Height="40" RadiusX="12" RadiusY="12" Fill="#09FFFFFF" />
                                    <sr:TapeReel Canvas.Left="96" Canvas.Top="66" Width="168" Height="168" SecondsPerTurn="3.2"
                                                 Pack="{Binding SourcePack}" IsSpinning="{Binding IsSpinning}" AutomationProperties.Name="Source reel" />
                                    <sr:TapeReel Canvas.Left="376" Canvas.Top="66" Width="168" Height="168" SecondsPerTurn="2.1"
                                                 Pack="{Binding OutputPack}" IsSpinning="{Binding IsSpinning}" AutomationProperties.Name="Output reel" />
                                    <ctl:TapePath Width="640" Height="256" SourcePack="{Binding SourcePack}" OutputPack="{Binding OutputPack}" IsHitTestVisible="False" />
                                    <Ellipse Canvas.Left="245" Canvas.Top="237" Width="14" Height="14" Fill="#A59B86" Stroke="#3A3833" />
                                    <Ellipse Canvas.Left="381" Canvas.Top="237" Width="14" Height="14" Fill="#A59B86" Stroke="#3A3833" />
                                    <Border Canvas.Left="290" Canvas.Top="236" Width="60" Height="18" CornerRadius="3" Background="#B9AD92">
                                        <sr:TrackedText Text="NVENC" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                        Tracking="0.2" Foreground="#2A2824" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <sr:CassetteLabel Canvas.Left="56" Canvas.Top="4" Width="528" Height="56" Padding="16,4,14,4"
                                                      Title="{Binding LabelTitle}" Side="{Binding LabelSide}" Episode="{Binding LabelEpisode}" />
                                    <sr:TrackedText Canvas.Left="58" Canvas.Top="210" Style="{StaticResource SR.SilkOnPlate}" FontSize="12" Tracking="0.16"
                                                    Text="{Binding SourceText}" />
                                    <Grid Canvas.Left="0" Canvas.Top="210" Width="582">
                                        <sr:TrackedText HorizontalAlignment="Right" Style="{StaticResource SR.Silk}" FontSize="12" Tracking="0.16"
                                                        Foreground="{DynamicResource SR.Phosphor}" Effect="{DynamicResource SR.PhosphorTextGlow}"
                                                        Text="{Binding OutputText}" />
                                    </Grid>
                                </Canvas>
                                <Border CornerRadius="16" Background="{DynamicResource SR.DeckWindow}" BorderBrush="Black" BorderThickness="2"
                                        Visibility="{Binding IsTapeLoaded, Converter={StaticResource Hidden}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="16" Tracking="0.3" Text="No tape"
                                                        Foreground="{DynamicResource SR.SilkLight}" HorizontalAlignment="Center" />
                                        <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Tracking="0.14" Margin="0,12,0,0" HorizontalAlignment="Center"
                                                        Text="Pick a show on monitor A, then press Load tape" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ContentControl>

                        <!-- Readouts -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource SR.Plate}" Padding="12,8">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Episode" />
                                    <sr:SevenSegmentDisplay Text="{Binding EpisodeDigits}" DigitHeight="30" Spacing="3" VerticalAlignment="Top" />
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Style="{StaticResource SR.Plate}" Padding="12,8">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Tape time" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <sr:SevenSegmentDisplay Text="{Binding TapeTimeDigits}" DigitHeight="30" Spacing="3" />
                                        <TextBlock Style="{StaticResource Pixel}" Text="{Binding TapeTotalText}" Foreground="#8F8670"
                                                   VerticalAlignment="Bottom" Margin="12,0,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="4" Style="{StaticResource SR.Plate}" Padding="12,8">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Frames / s" />
                                    <sr:SevenSegmentDisplay Text="{Binding FpsDigits}" DigitHeight="30" Spacing="3" VerticalAlignment="Top" />
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="6" Style="{StaticResource SR.Plate}" Padding="12,8">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Percent" />
                                    <sr:SevenSegmentDisplay Text="{Binding PercentDigits}" DigitHeight="30" Spacing="3" VerticalAlignment="Top" />
                                </DockPanel>
                            </ContentControl>
                        </Grid>

                        <!-- Transport keys -->
                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <sr:PianoLatchKey x:Name="EncodeKey" Label="Encode" IsRecord="True" ShowLamp="True" MinWidth="0" VerticalAlignment="Top"
                                              Icon="{StaticResource SR.Icon.Record}" IsChecked="{Binding IsEncoding, Mode=OneWay}"
                                              Lamp="{Binding EncodeLamp}" LampBlink="{Binding EncodeLampBlink}"
                                              Command="{Binding EncodeCommand}" Click="OnLatchClick" AutomationProperties.Name="Start encoding" />
                            <sr:PianoLatchKey x:Name="PauseKey" Grid.Column="2" Label="Pause" MinWidth="0" VerticalAlignment="Top"
                                              Icon="{StaticResource SR.Icon.Pause}" IsChecked="{Binding IsPaused, Mode=OneWay}"
                                              Command="{Binding PauseCommand}" Click="OnLatchClick" AutomationProperties.Name="Pause the encode" />
                            <sr:PianoKey Grid.Column="4" Label="Stop" MinWidth="0" VerticalAlignment="Top" Icon="{StaticResource SR.Icon.Stop}"
                                         Command="{Binding StopCommand}" AutomationProperties.Name="Stop and discard this encode" />
                            <sr:PianoKey Grid.Column="6" Label="Skip ep" MinWidth="0" VerticalAlignment="Top" Icon="{StaticResource SR.Icon.Skip}"
                                         Command="{Binding SkipCommand}" AutomationProperties.Name="Skip this episode" />
                            <sr:PianoKey Grid.Column="8" Label="Eject" MinWidth="0" VerticalAlignment="Top" Icon="{StaticResource SR.Icon.Eject}"
                                         Command="{Binding EjectCommand}" AutomationProperties.Name="Eject the show" />
                        </Grid>

                        <!-- Meters and quality -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource SR.Bezel}" Padding="9">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource SR.Silk}" FontSize="10" Text="Video out"
                                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <sr:VuMeter Height="Auto" MinWidth="0" Caption="Mbps" Minimum="0" Maximum="8" MinLabel="0" MidLabel="4" MaxLabel="8"
                                                Value="{Binding BitrateMbps}" AutomationProperties.Name="Output video bitrate, megabits per second" />
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Style="{StaticResource SR.Bezel}" Padding="9">
                                <DockPanel>
                                    <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource SR.Silk}" FontSize="10" Text="Encoder load"
                                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <sr:VuMeter Height="Auto" MinWidth="0" Caption="Load %" Minimum="0" Maximum="100" MinLabel="0" MidLabel="50" MaxLabel="100"
                                                Value="{Binding EncoderLoad}" AutomationProperties.Name="NVENC encoder load, percent" />
                                </DockPanel>
                            </ContentControl>
                            <ContentControl Grid.Column="4" Style="{StaticResource SR.Bezel}" Padding="6,4,6,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- The phosphor tick marks the default CQ, the tested balance. Reset clears the show's override. -->
                                    <sr:RotaryKnob Width="96" Height="90" Labels="{Binding CqLabels}" SelectedIndex="{Binding CqIndex}"
                                                   RecommendedIndex="{Binding RecommendedCqIndex}"
                                                   IsEnabled="{Binding IsKnobEnabled}" Caption="Quality CQ" />
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" FontSize="10" Text="Quality · CQ" HorizontalAlignment="Center" />
                                    <DockPanel Margin="0,3,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallKey}" Content="Reset" Margin="6,0,0,0"
                                                Command="{Binding ResetCqCommand}"
                                                AutomationProperties.Name="Reset this show to the default quality" />
                                        <sr:TrackedText Style="{StaticResource SR.Silk}" FontSize="10" Text="{Binding CqSourceText}"
                                                        VerticalAlignment="Center" />
                                    </DockPanel>
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" FontSize="10" Text="{Binding EstimateText}" HorizontalAlignment="Center"
                                                    Opacity="0.8" Margin="0,3,0,0" />
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </Grid>

                    <!-- Right: J-card and lifetime counter -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="112" />
                        </Grid.RowDefinitions>

                        <ContentControl Style="{StaticResource SR.Bezel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                                    <sr:TrackedText DockPanel.Dock="Right" Style="{StaticResource SR.Silk}" FontSize="10" Opacity="0.8"
                                                    Text="{Binding JCardHeader}" VerticalAlignment="Center" />
                                    <sr:TrackedText Style="{StaticResource SR.Silk}" Text="J-card · track list" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Seasons}" Margin="0,0,0,6" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SeasonChipViewModel}">
                                            <sr:SeasonChip GroupName="seasons" Content="{Binding Label}" Width="34" Margin="0,0,3.5,4"
                                                           IsChecked="{Binding IsSelected}" Lamp="{Binding Lamp}" LampBlink="{Binding Blink}"
                                                           AutomationProperties.Name="{Binding AutomationName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border CornerRadius="6" Background="{DynamicResource SR.JCard}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Height="20" Margin="0,2,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <sr:TrackedText Grid.Column="1" Text="Ep" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="#7A7160" VerticalAlignment="Center" />
                                            <sr:TrackedText Grid.Column="2" Text="Title" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="#7A7160" VerticalAlignment="Center" />
                                            <sr:TrackedText Grid.Column="3" Text="GB" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="#7A7160" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <sr:TrackedText Grid.Column="4" Text="Status" FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="Bold" FontSize="10"
                                                            Tracking="0.16" Foreground="#7A7160" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SR.JCardRule}" />
                                        <sr:TrackedText DockPanel.Dock="Bottom" Margin="10,6" Text="{Binding SeasonFooter}" FontFamily="{DynamicResource SR.Font.Silk}"
                                                        FontWeight="SemiBold" FontSize="12" Tracking="0.12" Foreground="#7A7160" />
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" PanningMode="VerticalOnly">
                                            <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackRow}" Focusable="False"
                                                          AutomationProperties.Name="Episodes in this season" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </ContentControl>

                        <ContentControl Grid.Row="2" Style="{StaticResource SR.Plate}" Padding="22,12">
                            <DockPanel>
                                <sr:TrackedText DockPanel.Dock="Bottom" Style="{StaticResource PlateLabel}" Text="Saved, all time" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <sr:SevenSegmentDisplay Text="{Binding LifetimeSavedDigits}" DigitHeight="48" Spacing="4" Glow="True"
                                                            AutomationProperties.Name="{Binding LifetimeSavedName}" />
                                    <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="18" Tracking="0" Text="{Binding LifetimeSavedUnit}"
                                                    Margin="12,0,0,2" VerticalAlignment="Bottom" Foreground="{DynamicResource SR.Phosphor}"
                                                    Effect="{DynamicResource SR.PhosphorTextGlow}" />
                                </StackPanel>
                            </DockPanel>
                        </ContentControl>
                    </Grid>
                </Grid>

                <!-- ============ FOOTER ============ -->
                <ContentControl Grid.Row="4" Style="{StaticResource SR.Plate}" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Text="{Binding FooterTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <sr:SevenSegmentDisplay Text="{Binding SavedDigits}" DigitHeight="74" Spacing="5" Glow="True"
                                                        AutomationProperties.Name="Gigabytes reclaimed" />
                                <sr:TrackedText Style="{StaticResource SR.Wordmark}" FontSize="22" Tracking="0" Text="GB" Margin="14,0,0,6"
                                                VerticalAlignment="Bottom" Foreground="{DynamicResource SR.Phosphor}"
                                                Effect="{DynamicResource SR.PhosphorTextGlow}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <DockPanel>
                                <sr:TrackedText DockPanel.Dock="Right" Style="{StaticResource SR.Silk}" FontSize="12" Text="{Binding EpisodesDoneText}"
                                                Foreground="{DynamicResource SR.Phosphor}" Effect="{DynamicResource SR.PhosphorTextGlow}" />
                                <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Text="Show size · GB" />
                            </DockPanel>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <sr:TrackedText Style="{StaticResource PlateLabel}" Text="Before" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Height="14" CornerRadius="2" Background="{DynamicResource SR.BarTrack}" Margin="0,0,8,0">
                                    <Border CornerRadius="2" Background="#8F8670" />
                                </Border>
                                <TextBlock Grid.Column="2" Style="{StaticResource Pixel}" Text="{Binding BeforeText}" Foreground="{DynamicResource SR.SilkLight}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <sr:TrackedText Grid.Row="1" Style="{StaticResource PlateLabel}" Text="After" VerticalAlignment="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Height="14" CornerRadius="2" Background="{DynamicResource SR.BarTrack}" Margin="0,0,8,0">
                                    <Border CornerRadius="2" Background="{DynamicResource SR.Phosphor}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding AfterFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Pixel}" Text="{Binding AfterText}" Foreground="{DynamicResource SR.Phosphor}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <sr:LedBar Segments="36" Height="10" Margin="0,8,0,0" Fraction="{Binding HandledFraction}" GlowBrush="{DynamicResource SR.PhosphorGlow}"
                                       AutomationProperties.Name="Episodes handled" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <sr:TrackedText Style="{StaticResource SR.SilkOnPlate}" Text="Originals" />
                            <sr:Lamp Style="{StaticResource PanelLamp}" Foreground="{DynamicResource SR.CreamInk}" Margin="0,10,0,0"
                                     Content="{Binding OriginalsLamp.Label}" State="{Binding OriginalsLamp.State}" />
                            <sr:Lamp Style="{StaticResource PanelLamp}" Foreground="{DynamicResource SR.CreamInk}" Margin="0,8,0,0"
                                     Content="{Binding RecycleLamp.Label}" State="{Binding RecycleLamp.State}" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding OpenSettingsCommand}"
                                    FocusVisualStyle="{DynamicResource SR.FocusVisual}" AutomationProperties.Name="Change in settings">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <sr:TrackedText Style="{StaticResource PlateLabel}" Tracking="0.1" Opacity="0.7" Text="Change in settings" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </Grid>

            <!-- ============ SERVICE PANEL ============ -->
            <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}" Margin="-22,-18">
                <Rectangle Fill="#8C000000" MouseDown="OnScrimDown" />
                <ContentControl Style="{StaticResource SR.Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                    <StackPanel>
                        <DockPanel>
                            <sr:PianoKey DockPanel.Dock="Right" Label="Close" MinWidth="88" Width="88"
                                         Command="{Binding CloseSettingsCommand}" AutomationProperties.Name="Close the service panel" />
                            <StackPanel VerticalAlignment="Top">
                                <sr:TrackedText Style="{StaticResource SR.Heading}" Text="Service panel" />
                                <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,6,0,0" FontSize="13"
                                           Text="Saved to this machine as soon as you change it." />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <sr:TrackedText Style="{StaticResource SR.Silk}" Text="Originals" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <ToggleButton Style="{StaticResource SR.ToggleSwitch}" Content="Replace after checks pass" VerticalAlignment="Center"
                                              IsChecked="{Binding ReplaceOriginals}" IsEnabled="{Binding CanEditSettings}"
                                              AutomationProperties.Name="Replace originals after every check passes" />
                                <sr:DymoLabel Text="Deletes originals" Tape="Red" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="1" Style="{StaticResource SR.Silk}" Text="Fonts" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource SR.ToggleSwitch}" Margin="0,6" HorizontalAlignment="Left"
                                          Content="Restore MKV fonts if an encode drops them" IsChecked="{Binding RestoreFonts}"
                                          IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="Restore fonts" />

                            <sr:TrackedText Grid.Row="2" Style="{StaticResource SR.Silk}" Text="Encode window" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="2" Grid.Column="1" Style="{StaticResource SR.ToggleSwitch}" Margin="0,6" HorizontalAlignment="Left"
                                          IsChecked="{Binding EncodeWindowEnabled}" IsEnabled="{Binding CanEditSettings}"
                                          AutomationProperties.Name="Only start episodes inside the encode window">
                                <TextBlock><Run Text="Only start episodes during " /><Run Text="{Binding WindowText, Mode=OneWay}" /></TextBlock>
                            </ToggleButton>

                            <sr:TrackedText Grid.Row="3" Style="{StaticResource SR.Silk}" Text="Window times" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowStartEarlierCommand}"
                                        AutomationProperties.Name="Open the window half an hour earlier">
                                    <Path Data="{StaticResource StepEarlier}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <ContentControl Style="{StaticResource SR.Plate}" Padding="10,6" Margin="6,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Window opens">
                                    <sr:SevenSegmentDisplay Text="{Binding WindowStartText}" DigitHeight="18" Spacing="2"
                                                            AutomationProperties.Name="{Binding WindowStartText}" />
                                </ContentControl>
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowStartLaterCommand}"
                                        AutomationProperties.Name="Open the window half an hour later">
                                    <Path Data="{StaticResource StepLater}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <sr:TrackedText Style="{StaticResource SR.Silk}" Text="to" VerticalAlignment="Center" Margin="14,0" />
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowEndEarlierCommand}"
                                        AutomationProperties.Name="Close the window half an hour earlier">
                                    <Path Data="{StaticResource StepEarlier}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                                <ContentControl Style="{StaticResource SR.Plate}" Padding="10,6" Margin="6,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Window closes">
                                    <sr:SevenSegmentDisplay Text="{Binding WindowEndText}" DigitHeight="18" Spacing="2"
                                                            AutomationProperties.Name="{Binding WindowEndText}" />
                                </ContentControl>
                                <Button Style="{StaticResource StepKey}" Command="{Binding WindowEndLaterCommand}"
                                        AutomationProperties.Name="Close the window half an hour later">
                                    <Path Data="{StaticResource StepLater}" Fill="{DynamicResource SR.Ink}" Width="12" Height="12" Stretch="None" />
                                </Button>
                            </StackPanel>

                            <sr:TrackedText Grid.Row="4" Style="{StaticResource SR.Silk}" Text="Phosphor" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                <sr:SeasonChip GroupName="phosphor" Content="AMBER" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorAmber}" />
                                <sr:SeasonChip GroupName="phosphor" Content="GREEN" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorGreen}" />
                                <sr:SeasonChip GroupName="phosphor" Content="ICE" Style="{StaticResource OptionChip}" MinWidth="72" IsChecked="{Binding PhosphorIce}" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="5" Style="{StaticResource SR.Silk}" Text="Chassis" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                <sr:SeasonChip GroupName="chassis" Content="BEIGE" Style="{StaticResource OptionChip}" MinWidth="96" IsChecked="{Binding ChassisBeige}" />
                                <sr:SeasonChip GroupName="chassis" Content="GRAPHITE" Style="{StaticResource OptionChip}" MinWidth="96" IsChecked="{Binding ChassisGraphite}" />
                            </StackPanel>

                            <sr:TrackedText Grid.Row="6" Style="{StaticResource SR.Silk}" Text="Library" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Choose" Command="{Binding ChooseLibraryCommand}"
                                        AutomationProperties.Name="Choose the library folder" />
                                <TextBlock Style="{StaticResource SR.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,10,0" Text="{Binding LibraryRoot}" ToolTip="{Binding LibraryRoot}" />
                            </DockPanel>

                            <sr:TrackedText Grid.Row="7" Style="{StaticResource SR.Silk}" Text="Scratch" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextKey}" Content="Choose" Command="{Binding ChooseScratchCommand}"
                                        AutomationProperties.Name="Choose the local scratch folder" />
                                <TextBlock Style="{StaticResource SR.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,10,0" Text="{Binding ScratchFolder}" ToolTip="{Binding ScratchFolder}" />
                            </DockPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,14,0,0" Text="{Binding Notice}"
                                   Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ============ CLOSE CONFIRM ============ -->
            <!-- Closing during a run asks first. Escape keeps running; once confirmed, the card shows the wait. -->
            <Grid x:Name="CloseOverlay" Visibility="{Binding IsCloseOverlayOpen, Converter={StaticResource Visible}}" Margin="-22,-18">
                <Rectangle Fill="#8C000000" />
                <ContentControl Style="{StaticResource SR.Card}" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22"
                                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                                AutomationProperties.Name="Close ShrinkRay during a run">
                    <StackPanel>
                        <sr:TrackedText Style="{StaticResource SR.Heading}" Text="{Binding CloseHeading}" />
                        <TextBlock Style="{StaticResource SR.Text.Caption}" Margin="0,10,0,0" FontSize="14" Text="{Binding CloseText}" />
                        <ContentControl Style="{StaticResource SR.Plate}" Margin="0,18,0,0" Padding="14,10" HorizontalAlignment="Left">
                            <sr:Lamp Style="{StaticResource PanelLamp}" Foreground="{DynamicResource SR.SilkLight}"
                                     Content="{Binding RunLamp.Label}" State="{Binding RunLamp.State}" Blink="{Binding RunLamp.Blink}" />
                        </ContentControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"
                                    Visibility="{Binding IsCloseConfirmOpen, Converter={StaticResource Visible}}">
                            <sr:PianoKey x:Name="KeepRunningKey" Label="Keep running" MinWidth="150" Width="150"
                                         Command="{Binding CancelCloseCommand}" AutomationProperties.Name="Keep running and leave ShrinkRay open" />
                            <sr:PianoKey Label="{Binding CloseKeyLabel}" MinWidth="150" Width="150" Margin="14,0,0,0"
                                         Command="{Binding ConfirmCloseCommand}" AutomationProperties.Name="{Binding CloseKeyLabel}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </ContentControl>
    </ctl:DeckScaler>
</Window>
