<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ShrinkRay.Theme</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Fonts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShrinkRay.Theme.Tests" />
  </ItemGroup>

</Project>
