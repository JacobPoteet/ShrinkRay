<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Default styles for the custom controls. They read tokens through DynamicResource, so the
        app must merge ShrinkRayTheme, which holds the tokens and the starting palette.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ShrinkRay.Theme;component/Themes/Keys.xaml" />
        <ResourceDictionary Source="/ShrinkRay.Theme;component/Themes/Readouts.xaml" />
        <ResourceDictionary Source="/ShrinkRay.Theme;component/Themes/Labels.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
