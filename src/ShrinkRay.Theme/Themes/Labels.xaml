<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="clr-namespace:ShrinkRay.Theme.Controls">

    <Style TargetType="sr:CassetteLabel">
        <Setter Property="Padding" Value="14,6,14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sr:CassetteLabel">
                    <Grid>
                        <Border Margin="0,1,0,-1" CornerRadius="3" Background="#66000000">
                            <Border.Effect>
                                <BlurEffect Radius="4" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="3" Background="{DynamicResource SR.Cream}" sr:RoundClip.Radius="3">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Bottom" Height="4" Background="{DynamicResource SR.Stripe1}" />
                                <Border DockPanel.Dock="Bottom" Height="7" Background="{DynamicResource SR.Stripe3}" />
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource SR.Text.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <sr:TrackedText Text="{TemplateBinding Side}" HorizontalAlignment="Right"
                                                        FontFamily="{DynamicResource SR.Font.Silk}" FontWeight="SemiBold"
                                                        FontSize="10" Tracking="0.18"
                                                        Foreground="{DynamicResource SR.PrintInkSoft}" />
                                        <!-- The episode code stays put; only the title beside it scrolls. -->
                                        <StackPanel x:Name="EpisodeLine" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                            <TextBlock Text="{TemplateBinding Episode}" Style="{DynamicResource SR.Text.Label}" FontSize="14" />
                                            <TextBlock x:Name="EpisodeDot" Text="·" Style="{DynamicResource SR.Text.Label}" FontSize="14"
                                                       Margin="7,0,7,0" />
                                            <sr:MarqueeText x:Name="EpisodeTitleText" Text="{TemplateBinding EpisodeTitle}" MaxWidth="230"
                                                            FontFamily="{DynamicResource SR.Font.Label}" FontSize="14"
                                                            Foreground="{DynamicResource SR.Marker}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Episode" Value="">
                            <Setter TargetName="EpisodeLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Episode" Value="{x:Null}">
                            <Setter TargetName="EpisodeLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="EpisodeTitle" Value="">
                            <Setter TargetName="EpisodeDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EpisodeTitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="EpisodeTitle" Value="{x:Null}">
                            <Setter TargetName="EpisodeDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EpisodeTitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Embossed tape: a light edge under each letter and a dark one over it -->
    <Style TargetType="sr:DymoLabel">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Silk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sr:DymoLabel">
                    <Grid>
                        <Border Margin="0,1,0,-1" CornerRadius="2" Background="#73000000">
                            <Border.Effect>
                                <BlurEffect Radius="3" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Tape" CornerRadius="2" Background="{DynamicResource SR.Dymo}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <sr:TrackedText Text="{TemplateBinding Text}" Tracking="0.22" Foreground="#33FFFFFF"
                                                RenderTransform="{x:Static sr:DymoOffsets.Down}" />
                                <sr:TrackedText Text="{TemplateBinding Text}" Tracking="0.22" Foreground="Black"
                                                RenderTransform="{x:Static sr:DymoOffsets.Up}" />
                                <sr:TrackedText Text="{TemplateBinding Text}" Tracking="0.22" Foreground="{DynamicResource SR.DymoInk}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tape" Value="Red">
                            <Setter TargetName="Tape" Property="Background" Value="{DynamicResource SR.DymoRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
