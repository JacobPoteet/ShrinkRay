<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="clr-namespace:ShrinkRay.Theme.Controls">

    <!-- The head lamp's word, in the lamp's own ink -->
    <DataTemplate x:Key="SR.TapeDeck.HeadWord">
        <sr:TrackedText Text="{Binding}" Style="{DynamicResource SR.Silk}" FontSize="11" Tracking="0.12"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=sr:Lamp}}" />
    </DataTemplate>

    <!--
        Drawn in TapeDeckMath's 640 by 256 design space and scaled to fit, so the main deck shows it
        at 1:1 and the mini cassette at its own size. The positions match TapeDeckMath's constants.
    -->
    <Style TargetType="sr:TapeDeck">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sr:TapeDeck">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="640" Height="256">
                            <Rectangle Canvas.Left="40" Canvas.Top="66" Width="560" Height="168" RadiusX="16" RadiusY="16"
                                       Fill="{DynamicResource SR.DeckWindow}" Stroke="Black" StrokeThickness="2" />
                            <Rectangle Canvas.Left="44" Canvas.Top="70" Width="552" Height="40" RadiusX="12" RadiusY="12" Fill="#09FFFFFF" />
                            <sr:TapeReel Canvas.Left="96" Canvas.Top="66" Width="168" Height="168"
                                         SecondsPerTurn="{TemplateBinding SourceSecondsPerTurn}"
                                         Pack="{TemplateBinding SourcePack}" IsSpinning="{TemplateBinding IsSpinning}"
                                         AutomationProperties.Name="Source reel" />
                            <sr:TapeReel Canvas.Left="376" Canvas.Top="66" Width="168" Height="168"
                                         SecondsPerTurn="{TemplateBinding OutputSecondsPerTurn}"
                                         Pack="{TemplateBinding OutputPack}" IsSpinning="{TemplateBinding IsSpinning}"
                                         AutomationProperties.Name="Output reel" />
                            <sr:TapePath Width="640" Height="256" SourcePack="{TemplateBinding SourcePack}"
                                         OutputPack="{TemplateBinding OutputPack}" IsHitTestVisible="False" />
                            <Ellipse Canvas.Left="245" Canvas.Top="237" Width="14" Height="14" Fill="{DynamicResource SR.Roller}" Stroke="#3A3833" />
                            <Ellipse Canvas.Left="381" Canvas.Top="237" Width="14" Height="14" Fill="{DynamicResource SR.Roller}" Stroke="#3A3833" />
                            <!-- The encoder head on the tape run; its lamp lights while NVENC is working -->
                            <Grid Canvas.Left="282" Canvas.Top="237" Width="76" Height="19">
                                <Border CornerRadius="3" Background="{DynamicResource SR.PartFill}" BorderBrush="#3A3833" BorderThickness="1" />
                                <Border Margin="1" CornerRadius="2" BorderThickness="0,1,0,0" BorderBrush="#80FFFFFF" />
                                <sr:Lamp x:Name="HeadLamp" Diameter="8" Spacing="6" Content="NVENC" Foreground="{DynamicResource SR.PartInk}"
                                         ContentTemplate="{StaticResource SR.TapeDeck.HeadWord}" AutomationProperties.Name="NVENC"
                                         State="{TemplateBinding HeadLamp}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <sr:CassetteLabel x:Name="FullLabel" Canvas.Left="56" Canvas.Top="4" Width="528" Height="56" Padding="16,4,14,4"
                                              Title="{TemplateBinding Title}" Episode="{TemplateBinding Episode}"
                                              EpisodeTitle="{TemplateBinding EpisodeTitle}" />
                            <!--
                                The compact label: the same cream stock and stripes, with the show and the episode
                                code in marker about half again as large, and no scrolling episode title.
                            -->
                            <Grid x:Name="CompactLabel" Canvas.Left="56" Canvas.Top="2" Width="528" Height="60" Visibility="Collapsed">
                                <Border Margin="0,1,0,-1" CornerRadius="3" Background="#66000000">
                                    <Border.Effect>
                                        <BlurEffect Radius="4" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="3" Background="{DynamicResource SR.Cream}" sr:RoundClip.Radius="3">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Bottom" Height="4" Background="{DynamicResource SR.Stripe1}" />
                                        <Border DockPanel.Dock="Bottom" Height="7" Background="{DynamicResource SR.Stripe3}" />
                                        <DockPanel Margin="16,0,14,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Episode}" Style="{DynamicResource SR.Text.Label}"
                                                       FontSize="30" VerticalAlignment="Center" Margin="16,0,0,0" />
                                            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource SR.Text.Label}" FontSize="36"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <sr:TrackedText x:Name="SourceCaption" Canvas.Left="58" Canvas.Top="210" Style="{DynamicResource SR.SilkOnPlate}"
                                            FontSize="12" Tracking="0.16"
                                            Text="{TemplateBinding SourceCaption}" ToolTip="{TemplateBinding SourceDetail}" />
                            <Grid x:Name="OutputCaption" Canvas.Left="0" Canvas.Top="210" Width="582">
                                <sr:TrackedText HorizontalAlignment="Right" Style="{DynamicResource SR.Silk}" FontSize="12" Tracking="0.16"
                                                Foreground="{DynamicResource SR.Phosphor}" Effect="{DynamicResource SR.PhosphorTextGlow}"
                                                Text="{TemplateBinding OutputCaption}" ToolTip="{TemplateBinding OutputDetail}" />
                            </Grid>
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Density" Value="Compact">
                            <Setter TargetName="SourceCaption" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OutputCaption" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FullLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CompactLabel" Property="Visibility" Value="Visible" />
                            <!-- Too small to read its word at this size, and a lamp never goes without one -->
                            <Setter TargetName="HeadLamp" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
