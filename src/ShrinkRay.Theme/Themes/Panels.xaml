<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="clr-namespace:ShrinkRay.Theme.Controls">

    <!--
        Panel styles for ContentControl. Apply with Style="{DynamicResource SR.Bezel}" and so on.
        Shadows sit on content-free layers, so text inside never renders through an effect.
    -->

    <!-- Chassis: the molded case. 175 degree gradient and a screw in each corner. -->
    <Style x:Key="SR.Chassis" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
        <Setter Property="Padding" Value="22,18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{DynamicResource SR.ChassisSurface}">
                        <sr:Screw Width="13" Height="13" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top" SlotAngle="35" />
                        <sr:Screw Width="13" Height="13" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Top" SlotAngle="80" />
                        <sr:Screw Width="13" Height="13" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" SlotAngle="10" />
                        <sr:Screw Width="13" Height="13" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" SlotAngle="125" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card: a raised module on the kit board -->
    <Style x:Key="SR.Card" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="0,2,0,-2" CornerRadius="12" Background="#4D000000" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="6" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" Background="{DynamicResource SR.KeyCap}" />
                        <Border CornerRadius="12" BorderThickness="0,2,0,0" BorderBrush="#99FFFFFF" IsHitTestVisible="False" />
                        <Border CornerRadius="12" BorderThickness="0,0,0,3" BorderBrush="#2E000000" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bezel: the raised frame around a screen or a group of controls -->
    <Style x:Key="SR.Bezel" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="0,2,0,-2" CornerRadius="14" Background="#40000000" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="4" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14" Background="{DynamicResource SR.BezelFill}" />
                        <Border CornerRadius="14" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource SR.AbsHi}" IsHitTestVisible="False" />
                        <Border CornerRadius="14" BorderThickness="0,0,0,3" BorderBrush="#40000000" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plate: anodized charcoal, recessed into the chassis, with a lit lower lip -->
    <Style x:Key="SR.Plate" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource SR.SilkLight}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="0,0,0,-1" CornerRadius="8" Background="{DynamicResource SR.AbsHi}" />
                        <Border CornerRadius="8" Background="{DynamicResource SR.PlateFill}" />
                        <sr:InsetShadow CornerRadius="8" Blur="8" OffsetY="2" Color="#B3000000" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Readout: a plate behind a domed acrylic window, for lit digits and LED bars. The content is
         clipped to the window, so no light leaks onto the case, and the glass lies over it. -->
    <Style x:Key="SR.Readout" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource SR.SilkLight}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="0,0,0,-1" CornerRadius="8" Background="{DynamicResource SR.AbsHi}" />
                        <Border CornerRadius="8" Background="{DynamicResource SR.PlateFill}" />
                        <Grid sr:RoundClip.Radius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <sr:GlassPane />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LED slot: the dark channel an LED bar is set into, with a lit lower lip -->
    <Style x:Key="SR.LedSlot" TargetType="Border">
        <Setter Property="Background" Value="#100F0D" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="3,3,3,2" />
    </Style>

    <!-- Nameplate: the dark badge plate that carries the wordmark -->
    <Style x:Key="SR.Nameplate" TargetType="ContentControl">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="0,2,0,-2" CornerRadius="6" Background="#59000000" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="4" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource SR.NameplateFill}" />
                        <Border CornerRadius="6" BorderThickness="0,1,0,0" BorderBrush="#26FFFFFF" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch: a recessed slot with a sliding thumb. A real ToggleButton. -->
    <Style x:Key="SR.ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource SR.InkSoft}" />
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Silk}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="38" Height="20" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Ring" Margin="-1" CornerRadius="11" BorderThickness="1"
                                    BorderBrush="{DynamicResource SR.PhosphorDim}" Visibility="Collapsed" />
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SR.ToggleTrack}" />
                            <sr:InsetShadow CornerRadius="10" Blur="4" OffsetY="2" Color="#CC000000" />
                            <!-- Where the knob rests follows IsChecked through a setter. The slide only
                                 plays on top and ends at nothing, so a render that never runs the
                                 clock still shows the switch's real state. -->
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0,0,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource SR.ToggleKnob}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Thumb" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SR.ToggleTrackOn}" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="X" From="-18" To="0"
                                                         Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="X" From="18" To="0"
                                                         Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hardware key: the small keycaps for minimize and close. Content is a 12 px icon path. -->
    <Style x:Key="SR.HardwareKey" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="29" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Border Margin="0,3,0,0" CornerRadius="4" Background="{DynamicResource SR.AbsLo}" />
                        <Grid x:Name="Cap" Margin="0,0,0,3">
                            <Border CornerRadius="4" Background="{DynamicResource SR.KeyCap}" />
                            <Border x:Name="Highlight" CornerRadius="4" BorderThickness="0,1,0,0" BorderBrush="#80FFFFFF" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cap" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="3" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CRT list: rows on a CrtPanel. The selected row is drawn in solid phosphor with tube-black text. -->
    <Style x:Key="SR.CrtListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SR.Phosphor}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SR.Phosphor}" />
                            <Setter Property="Foreground" Value="{DynamicResource SR.Crt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SR.CrtListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Phosphor}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SR.CrtListBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
