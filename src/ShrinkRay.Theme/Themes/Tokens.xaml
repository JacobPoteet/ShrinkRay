<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="clr-namespace:ShrinkRay.Theme.Controls">

    <!--
        Fixed tokens. Chassis and phosphor tokens change at runtime, so ThemeManager writes those
        in code (see ThemeKeys). Reference everything here with DynamicResource too, so a page
        never depends on dictionary order.
    -->

    <!-- Fonts -->
    <FontFamily x:Key="SR.Font.Wordmark">pack://application:,,,/ShrinkRay.Theme;component/Fonts/#Michroma</FontFamily>
    <FontFamily x:Key="SR.Font.Silk">pack://application:,,,/ShrinkRay.Theme;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="SR.Font.Pixel">pack://application:,,,/ShrinkRay.Theme;component/Fonts/#scientifica</FontFamily>
    <FontFamily x:Key="SR.Font.Marker">pack://application:,,,/ShrinkRay.Theme;component/Fonts/#Permanent Marker</FontFamily>

    <!-- Surfaces -->
    <Color x:Key="SR.PlateColor">#262421</Color>
    <SolidColorBrush x:Key="SR.Board" Color="#2A2824" />
    <SolidColorBrush x:Key="SR.PlateFill" Color="#262421" />
    <SolidColorBrush x:Key="SR.Crt" Color="#0D0A05" />
    <SolidColorBrush x:Key="SR.DeckWindow" Color="#0C0B09" />
    <SolidColorBrush x:Key="SR.Cream" Color="#F1E9D6" />
    <SolidColorBrush x:Key="SR.JCard" Color="#EFE7D4" />
    <SolidColorBrush x:Key="SR.JCardRule" Color="#D8CEB8" />
    <SolidColorBrush x:Key="SR.Paper" Color="#F1E6C8" />
    <SolidColorBrush x:Key="SR.Oxide" Color="#3A281A" />
    <SolidColorBrush x:Key="SR.TapeRun" Color="#4A3322" />
    <SolidColorBrush x:Key="SR.Marker" Color="#1F3B73" />
    <SolidColorBrush x:Key="SR.PrintInk" Color="#3B352A" />
    <SolidColorBrush x:Key="SR.PrintInkSoft" Color="#5B5344" />
    <SolidColorBrush x:Key="SR.SilkLight" Color="#CFC4AB" />
    <SolidColorBrush x:Key="SR.CreamInk" Color="#EFE7D4" />
    <SolidColorBrush x:Key="SR.Unlit" Color="#8F8670" />
    <SolidColorBrush x:Key="SR.BarTrack" Color="#3A3632" />

    <!-- Signal red: Encode and anything that deletes -->
    <LinearGradientBrush x:Key="SR.SignalRed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E3603F" Offset="0" />
        <GradientStop Color="#B8381F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SR.SignalRedSide" Color="#7A2414" />
    <SolidColorBrush x:Key="SR.SignalRedInk" Color="#FFF1E4" />
    <SolidColorBrush x:Key="SR.RedZone" Color="#C0391F" />

    <!-- Lamps -->
    <Color x:Key="SR.LampGreenColor">#A6D651</Color>
    <Color x:Key="SR.LampRedColor">#FF5533</Color>
    <SolidColorBrush x:Key="SR.LampGreen" Color="#A6D651" />
    <SolidColorBrush x:Key="SR.LampRed" Color="#FF5533" />
    <SolidColorBrush x:Key="SR.LampOff" Color="#3A3226" />
    <SolidColorBrush x:Key="SR.KeyLampOff" Color="#4A3D22" />
    <RadialGradientBrush x:Key="SR.GreenHalo">
        <GradientStop Color="#8CA6D651" Offset="0" />
        <GradientStop Color="#8CA6D651" Offset="0.42" />
        <GradientStop Color="#00A6D651" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SR.RedHalo">
        <GradientStop Color="#99FF5533" Offset="0" />
        <GradientStop Color="#99FF5533" Offset="0.42" />
        <GradientStop Color="#00FF5533" Offset="1" />
    </RadialGradientBrush>

    <!-- Keys and hardware -->
    <SolidColorBrush x:Key="SR.KeyFloor" Color="#1A1916" />
    <SolidColorBrush x:Key="SR.ToggleTrack" Color="#1D1C19" />
    <SolidColorBrush x:Key="SR.ToggleTrackOn" Color="#3F3420" />
    <LinearGradientBrush x:Key="SR.ToggleKnob" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4EEE0" Offset="0" />
        <GradientStop Color="#A89E87" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SR.KnobBody" Color="#1F1E1B" />
    <SolidColorBrush x:Key="SR.KnobKnurl" Color="#45413A" />
    <SolidColorBrush x:Key="SR.KnobCap" Color="#2E2C28" />
    <SolidColorBrush x:Key="SR.Needle" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SR.Pivot" Color="#2A2824" />
    <SolidColorBrush x:Key="SR.ReelHub" Color="#ECE4D2" />
    <SolidColorBrush x:Key="SR.ReelHole" Color="#151412" />
    <SolidColorBrush x:Key="SR.Grille" Color="#1C1B18" />
    <LinearGradientBrush x:Key="SR.NameplateFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3833" Offset="0" />
        <GradientStop Color="#22201D" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="SR.ScrewFace" GradientOrigin="0.35,0.35" Center="0.35,0.35" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#F6F1E6" Offset="0" />
        <GradientStop Color="#8D8470" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="SR.ScrewSlot" Color="#5D5647" />

    <!-- Labels -->
    <SolidColorBrush x:Key="SR.Dymo" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SR.DymoRed" Color="#B4321E" />
    <SolidColorBrush x:Key="SR.DymoInk" Color="#F1EDE4" />
    <SolidColorBrush x:Key="SR.CassetteRule" Color="#C9BFA8" />

    <!-- The 70s badge stripes, top to bottom of the spectrum -->
    <SolidColorBrush x:Key="SR.Stripe1" Color="#F0B43C" />
    <SolidColorBrush x:Key="SR.Stripe2" Color="#E2862F" />
    <SolidColorBrush x:Key="SR.Stripe3" Color="#CF5A2A" />
    <SolidColorBrush x:Key="SR.Stripe4" Color="#A73A22" />

    <!-- Transport icons, drawn on a 16 px grid unless noted -->
    <Geometry x:Key="SR.Icon.Record">M1.5,8 A6.5,6.5 0 1 1 14.5,8 A6.5,6.5 0 1 1 1.5,8 Z</Geometry>
    <Geometry x:Key="SR.Icon.Pause">M2,2 H6.5 V14 H2 Z M9.5,2 H14 V14 H9.5 Z</Geometry>
    <Geometry x:Key="SR.Icon.Stop">M2,2 H14 V14 H2 Z</Geometry>
    <Geometry x:Key="SR.Icon.Skip">M1,2 L11,8 L1,14 Z M13,2 H16.5 V14 H13 Z</Geometry>
    <Geometry x:Key="SR.Icon.Eject">M8,1 L15,9 L1,9 Z M1,11.5 H15 V14.5 H1 Z</Geometry>
    <!-- 22 by 18 -->
    <Geometry x:Key="SR.Icon.Load">M9.8,1 H12.2 V9.1 L15.15,6.15 L16.85,7.85 L11,13.7 L5.15,7.85 L6.85,6.15 L9.8,9.1 Z M2,14 H20 V17 H2 Z</Geometry>
    <!-- 12 by 12 window keys -->
    <Geometry x:Key="SR.Icon.Minimize">M2,8 H10 V10 H2 Z</Geometry>
    <Geometry x:Key="SR.Icon.Maximize">M2,2 H10 V10 H2 Z M3.6,3.6 V8.4 H8.4 V3.6 Z</Geometry>
    <Geometry x:Key="SR.Icon.Close">M2.6,1.4 L6,4.8 L9.4,1.4 L10.6,2.6 L7.2,6 L10.6,9.4 L9.4,10.6 L6,7.2 L2.6,10.6 L1.4,9.4 L4.8,6 L1.4,2.6 Z</Geometry>

    <!-- Keyboard focus: a phosphor outline 3 px outside the control -->
    <Style x:Key="SR.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-5" BorderThickness="2" CornerRadius="7"
                            BorderBrush="{DynamicResource SR.Phosphor}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SR.FocusVisualRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-4" StrokeThickness="2" Stroke="{DynamicResource SR.Phosphor}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Type -->
    <Style x:Key="SR.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Silk}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SR.InkSoft}" />
    </Style>

    <Style x:Key="SR.Text.Pixel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Pixel}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="sr:PixelText.Size" Value="22" />
    </Style>

    <Style x:Key="SR.Text.PixelBold" TargetType="TextBlock" BasedOn="{StaticResource SR.Text.Pixel}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SR.Text.Marker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Marker}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Marker}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Silkscreen: uppercase Barlow Condensed 600, tracked +18% -->
    <Style x:Key="SR.Silk" TargetType="sr:TrackedText">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Silk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Tracking" Value="0.18" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
    </Style>

    <Style x:Key="SR.SilkOnPlate" TargetType="sr:TrackedText" BasedOn="{StaticResource SR.Silk}">
        <Setter Property="Foreground" Value="{DynamicResource SR.SilkLight}" />
    </Style>

    <Style x:Key="SR.Heading" TargetType="sr:TrackedText">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Wordmark}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Tracking" Value="0.3" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
    </Style>

    <Style x:Key="SR.Wordmark" TargetType="sr:TrackedText">
        <Setter Property="FontFamily" Value="{DynamicResource SR.Font.Wordmark}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Tracking" Value="0.26" />
        <Setter Property="Foreground" Value="{DynamicResource SR.Ink}" />
    </Style>

</ResourceDictionary>
